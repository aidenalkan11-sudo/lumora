{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": {
            "re": "(^|,\\s*)text/markdown(?:;|,|$)"
          }
        }
      ],
      "dest": "/api/agent-markdown?path=/"
    },
    {
      "src": "^/privacy/?$",
      "dest": "/privacy.html"
    },
    {
      "src": "^/contact/?$",
      "dest": "/contact.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": {
            "re": "(^|,\\s*)text/markdown(?:;|,|$)"
          }
        }
      ],
      "dest": "/api/agent-markdown?path=/$1"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://lumorasolutions.tech/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.lumorasolutions.tech"
        }
      ]
    }
  ]
}
