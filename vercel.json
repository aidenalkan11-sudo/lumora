{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": {
            "re": "(^|,\\s*)text/markdown(?:;|,|$)"
          }
        }
      ],
      "dest": "/api/agent-markdown?path=/"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": {
            "re": "(^|,\\s*)text/markdown(?:;|,|$)"
          }
        }
      ],
      "dest": "/api/agent-markdown?path=/$1"
    }
  ]
}
